# @BotFather bergan token
BOT_TOKEN=

# my.telegram.org -> API development tools (akkauntga kirish uchun)
API_ID=
API_HASH=

# Postgres (Supabase) — Render uchun shart. Bo'sh bo'lsa mahalliy bot.db ishlatiladi.
DATABASE_URL=

# Kuzatiladigan Telegram papkasi nomi
FOLDER_NAME=Mijozlar

# Standart eslatma oraliqlari (daqiqa) — botdagi Sozlamalar'da o'zgartirsa bo'ladi
REMIND_NEW_MIN=30
REMIND_PROGRESS_MIN=120

# Tungi tinchlik (soat)
QUIET_FROM_HOUR=22
QUIET_TO_HOUR=8

# Faqat Telegram Business rejimi uchun (Premium bo'lsa): kim ulay oladi, ID'lar vergul bilan
ALLOWED_OWNERS=

# Gemini AI (ixtiyoriy): aistudio.google.com -> Get API key. Bo'sh bo'lsa bot AI'siz ishlaydi.
GEMINI_API_KEY=
# Navbat bilan sinaladigan modellar (biri band bo'lsa keyingisi)
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3.8-flash
